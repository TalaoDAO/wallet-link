{
    "SCA_Tezos": {
        "format": "dc+sd-jwt",
        "vct": "urn:eudi:sca:crypto:tezos:1",
        "scope": "SCA_Tezos_scope",
        "cryptographic_binding_methods_supported": ["jwk"],
        "credential_signing_alg_values_supported": ["ES256"],
        "proof_types_supported": {
            "jwt": {
                "proof_signing_alg_values_supported": ["ES256"]
            }
        },
        "display": [
            {
                "name": "Crypto Ownership",
                "description": "Proof of Tezos crypto ownership for APTITUDE LSP use case",
                "locale": "en-GB",
                "background_color": "#1a73e8",
                "text_color": "#FFFFFF",
                "background_image": {
                    "uri": "https://talao.co/image/server/tezos-proof.png",
                    "alt_text": "Proof of Tezos crypto background image"
                }
            }
        ],
        "claims": [
            {
                "path": ["account_address"],
                "display": [
                    {"name": "Address", "locale": "en-US"}
                ]
            },
            {
                "path": ["blockchain_network"],
                "display": [
                    {"name": "Blockchain", "locale": "en-US"}
                ]
            }
        ],
        "credential_metadata": {
            "display": [
                {
                    "name": "Crypto Ownership",
                    "description": "Proof of Tezos crypto ownership for APTITUDE LSP use case",
                    "locale": "en-GB",
                    "background_color": "#1a73e8",
                    "text_color": "#FFFFFF",
                    "background_image": {
                        "uri": "https://talao.co/image/server/tezos-proof.png",
                        "alt_text": "Proof of Tezos crypto background image"
                    }
                }
            ],
            "claims": [
                {
                    "path": ["account_address"],
                    "display": [
                        {"name": "Address", "locale": "en-US"}
                    ]
                },
                {
                    "path": ["blockchain_network"],
                    "display": [
                        {"name": "Blockchain", "locale": "en-US"}
